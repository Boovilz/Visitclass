# ตัวอย่าง reverse proxy สำหรับ nginx
# วางไว้ที่ /etc/nginx/sites-available/classroom-visit แล้ว symlink ไป sites-enabled
# แล้วตรวจไวยากรณ์ด้วย: sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name visit.example.ac.th;      # เปลี่ยนเป็นโดเมนจริง

    # หลังติดตั้งใบรับรอง HTTPS แล้ว ให้เปิดบรรทัดนี้เพื่อบังคับ HTTPS
    # return 301 https://$host$request_uri;

    # ขนาดไฟล์อัปโหลดสูงสุด ต้องไม่น้อยกว่าที่ระบบกำหนด (10 ไฟล์ x 5MB)
    client_max_body_size 60M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
