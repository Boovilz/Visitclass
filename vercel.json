{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": null,

  "buildCommand": "npm run build",

  "//": "dist/ มีเฉพาะ css/js/vendor — ไฟล์ .html ไม่อยู่ในนี้ เพราะหน้าเว็บต้องผ่านตัวแอปเพื่อใส่เลขเวอร์ชันไฟล์และตรวจสอบสิทธิ์",
  "outputDirectory": "dist",

  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "public/**"
    }
  },

  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
