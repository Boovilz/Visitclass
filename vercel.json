{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": null,

  "buildCommand": "npm run build",
  "outputDirectory": "public",

  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "public/**"
    }
  },

  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
