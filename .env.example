# ===== ตัวอย่างการตั้งค่า =====
# ท้องถิ่น: คัดลอกเป็นไฟล์ .env
# บน Vercel: ใส่ที่ Project Settings → Environment Variables

# --- ฐานข้อมูล Neon (จำเป็นสำหรับ production) ---
# ถ้าไม่ตั้งค่า ระบบจะใช้ Postgres ในเครื่อง (PGlite) สำหรับการพัฒนา
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- ที่เก็บรูปภาพ Vercel Blob (จำเป็นสำหรับ production) ---
# ถ้าไม่ตั้งค่า ระบบจะเก็บรูปลงโฟลเดอร์ uploads/ ในเครื่อง
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# --- กุญแจลงลายเซ็นเซสชัน (จำเป็นสำหรับ production) ---
# สร้างค่าใหม่: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SESSION_SECRET=

# --- ตั้งเมื่อเปิดผ่าน HTTPS ---
SECURE_COOKIE=1

# --- PIN เริ่มต้นตอนสร้างฐานข้อมูลครั้งแรก (ตัวเลข 4 หลัก) ---
# SEED_PIN=2468

# --- พอร์ต (เฉพาะตอนรันเองในเครื่อง/VPS) ---
PORT=3000
